# ============================================================
# SuperDocs Environment Configuration
# Copy this file to .env and replace environment-specific
# values where necessary.
# ============================================================

# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+psycopg://superdocs:superdocs@localhost:5432/superdocs

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=superdocs
POSTGRES_USER=superdocs
POSTGRES_PASSWORD=superdocs

# API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Frontend
WEB_HOST=localhost
WEB_PORT=5173
WEB_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:5173

# Storage
DOCUMENT_STORAGE_PATH=./data/documents

# Worker
WORKER_ID=local-worker
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=10
WORKER_POLL_INTERVAL_SECONDS=1

# Analysis
ANALYSIS_MODEL=deterministic

# External model provider
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=60

# Vector search
VECTOR_STORE_PROVIDER=postgres
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# MCP
MCP_SERVER_NAME=SuperDocs
MCP_TRANSPORT=stdio

# Observability
ENABLE_METRICS=true
ENABLE_TRACING=false
TRACE_SERVICE_NAME=superdocs

# Security
APP_SECRET_KEY=change-me-in-development

# Feature flags
ENABLE_INCREMENTAL_UPDATES=true
ENABLE_HUMAN_REVIEW=true
ENABLE_PROMPT_INJECTION_GUARD=true
ENABLE_STAGE_METRICS=true
